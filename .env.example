# PhoneVault MySQL Configuration

# Keep back ticks if you have special characters in your password.
MYSQL_ROOT_PASSWORD='change_me_root_password'

MYSQL_DATABASE=phonevault2

MYSQL_USER=phonevault2

# Keep back ticks if you have special characters in your password.
MYSQL_PASSWORD='change_me_user_password'

# Host port used to connect to MySQL.
# 3306 & 3307 is already used by another project on my machine (Feel free to use another port)
MYSQL_HOST_PORT=3308

# --- Running PhoneVault in Docker (python3 launch.py) ---
# launch.py fills in SECRET_KEY_BASE and replaces the change_me passwords with random ones.
SECRET_KEY_BASE=

# Port PhoneVault is served on (http://<server>:8080).
PHONEVAULT_PORT=8080

# Optional: folder where backup files are stored. Defaults to storage/backups/ in this repository.
# With Docker, this folder must be owned by user id 1000.
# PHONEVAULT_BACKUP_ROOT=/mnt/phonevault-backups

# Optional: largest upload in whole megabytes. Defaults to 10240 (10 GB).
# PHONEVAULT_MAX_UPLOAD_MB=10240
