<h1>New Backup</h1>

<p>
  Device: <%= @device.name %>
</p>

<%= form_with url: device_backups_path(@device), method: :post do |form| %>
  <div>
    <%= form.label :file, "Choose a file" %>
    <%= form.file_field :file, required: true %>
  </div>

  <div>
    <%= form.submit "Back Up File" %>
  </div>
<% end %>

<p>
  <%= link_to "Back to devices", devices_path %>
</p>
