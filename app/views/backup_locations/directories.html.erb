<h1 class="mb-6 text-3xl font-bold">Choose a save folder</h1>
<div class="rounded-xl border border-neutral-200 bg-white p-5">
  <p>Server path: <code class="break-all"><%= @path %></code></p>
  <p class="text-sm text-neutral-600">Browse server folders and select an existing writable directory. In Docker, only mounted folders are available. Select a folder, then choose the file to upload.</p>
  <div class="flex flex-wrap gap-3 my-4">
    <%= link_to "Use this folder", new_device_backup_run_path(@device, save_path: @path.to_s), class: button_classes %>
    <% unless @path == @root %>
      <%= link_to "Up", directories_device_backup_location_path(@device, path: @path.parent.to_s), class: button_classes(:secondary) %>
    <% end %>
    <%= link_to "Cancel", new_device_backup_run_path(@device), class: button_classes(:secondary) %>
  </div>
  <% if @directories.empty? %>
    <p>No subfolders in this directory.</p>
  <% else %>
    <ul class="space-y-3">
      <% @directories.each do |directory| %>
        <li><%= link_to directory.basename.to_s, directories_device_backup_location_path(@device, path: directory.to_s), class: "underline break-all" %></li>
      <% end %>
    </ul>
  <% end %>
</div>
