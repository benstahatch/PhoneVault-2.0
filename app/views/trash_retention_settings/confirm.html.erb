<h1 class="mb-3 text-3xl font-bold text-neutral-900">Confirm Retention Settings</h1>

<% if @automatic_cleanup_enabled %>
  <div role="alert" class="mb-6 max-w-4xl rounded-lg border border-red-300 bg-red-50 p-4 text-red-900">
    <p class="font-semibold">Backups will be permanently deleted after <%= @retention_days %> days in Trash.</p>
    <p class="mt-1">The scheduled cleanup will permanently delete files that have already passed this age. This cannot be undone. Review the list before confirming.</p>
  </div>
<% else %>
  <div role="status" class="mb-6 max-w-4xl rounded-lg border border-amber-300 bg-amber-50 p-4 text-amber-900">
    <p class="font-semibold">Server-level automatic cleanup is disabled.</p>
    <p class="mt-1">Saving this <%= @retention_days %>-day preference will not delete files now. The files below would already be eligible if the server administrator enables scheduled cleanup.</p>
  </div>
<% end %>

<section class="mb-6 max-w-4xl rounded-xl border border-neutral-200 bg-white p-6">
  <h2 class="mb-2 text-xl font-semibold text-neutral-900">Already eligible files</h2>
  <% if @eligible_files.any? %>
    <p class="mb-4 text-neutral-700"><%= pluralize(@eligible_files.length, "file") %> has been in Trash for at least <%= @retention_days %> days.</p>
    <div class="backup-history-scroll" role="region" aria-label="Files already eligible for retention cleanup" tabindex="0">
      <table class="backup-history">
        <thead>
          <tr>
            <th scope="col">File</th>
            <th scope="col">Device</th>
            <th scope="col">Deleted</th>
            <th scope="col">Expiration date</th>
          </tr>
        </thead>
        <tbody>
          <% @eligible_files.each do |file| %>
            <% expiration_at = TrashRetention.expiration_at(file.deleted_at, @retention_days) %>
            <tr>
              <td><strong><%= file.original_filename %></strong></td>
              <td><%= file.backup_run.device.name %></td>
              <td><%= timestamp(file.deleted_at) %></td>
              <td><%= timestamp(expiration_at) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <p class="text-neutral-600">No trashed files are already eligible for this retention period.</p>
  <% end %>
</section>

<section class="max-w-4xl rounded-xl border border-neutral-200 bg-white p-6">
  <%= form_with url: update_trash_retention_settings_path, method: :patch do |form| %>
    <%= hidden_field_tag :trash_retention_days, @retention_days %>
    <%= hidden_field_tag :confirmation_token, @confirmation_token %>
    <label class="mb-5 flex items-start gap-3 text-neutral-800">
      <%= check_box_tag :confirm_retention, "1", false, required: true, class: "mt-1 size-4 rounded border-neutral-400 text-[#e66b00] focus:ring-[#e66b00]" %>
      <span>I reviewed the warning and understand that expired files may be permanently deleted when server-level cleanup is enabled.</span>
    </label>
    <div class="flex flex-wrap gap-3">
      <%= form.submit "Confirm retention setting", class: button_classes(:danger) %>
      <%= link_to "Change selection", trash_retention_settings_path, class: button_classes(:secondary) %>
    </div>
  <% end %>
</section>
