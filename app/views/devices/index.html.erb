<% if flash[:notice] %>
  <p><%= flash[:notice] %></p>
<% end %>

<h1>Your Devices</h1>

<% if @devices.any? %>
  <ul>
    <% @devices.each do |device| %>
      <li>
        <%= device.name %> (<%= device.device_type %>)
        <%= link_to "Backups", device_backup_runs_path(device) %>
        <%= link_to "Upload", new_device_backup_run_path(device) %>
      </li>
    <% end %>
  </ul>
<% else %>
  <p>You haven't registered any devices yet.</p>
<% end %>

<%= link_to "Register a device", new_device_path %>

<hr>

<%= link_to "Back to dashboard", dashboard_path %>
