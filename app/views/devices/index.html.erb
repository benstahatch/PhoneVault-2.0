<% if flash[:notice] %>
  <p><%= flash[:notice] %></p>
<% end %>

<h1 class="mb-6 text-3xl sm:text-4xl font-bold text-neutral-900">Your Devices</h1>

<% if @devices.any? %>
  <ul class="m-0 mb-6 grid list-none gap-3 p-0">
    <% @devices.each do |device| %>
      <li class="flex flex-wrap items-center justify-between gap-3 rounded-xl border border-neutral-200 bg-white p-4">
        <span class="font-semibold text-neutral-900">
          <%= device.name %> <span class="font-normal text-neutral-600">(<%= device.device_type %>)</span>
        </span>
        <span class="flex flex-wrap gap-2">
          <%= link_to "Rename", edit_device_path(device), class: button_classes(:secondary, size: :small),
                aria: { label: "Rename #{device.name}" } %>
          <%= link_to "Backups", device_backup_runs_path(device), class: button_classes(:secondary, size: :small) %>
          <%= link_to "Upload", new_device_backup_run_path(device), class: button_classes(:primary, size: :small) %>
        </span>
      </li>
    <% end %>
  </ul>
<% else %>
  <p class="mb-6 text-neutral-600">You haven't registered any devices yet.</p>
<% end %>

<div class="flex flex-wrap gap-3">
  <%= link_to "Register a device", new_device_path, class: button_classes(:primary) %>
  <%= link_to "Back to dashboard", dashboard_path, class: button_classes(:secondary) %>
</div>
