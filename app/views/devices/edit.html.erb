<h1 class="mb-6 text-3xl sm:text-4xl font-bold text-neutral-900">Rename Device</h1>

<div class="box-border max-w-lg rounded-xl border border-neutral-200 bg-white p-5 sm:p-6">
  <% if @device.errors.any? %>
    <div class="mb-5 rounded-lg border border-red-200 bg-red-50 p-4 text-sm text-red-800">
      <h2 class="m-0 mb-2 text-sm font-semibold"><%= pluralize(@device.errors.count, "error") %> prevented this device from being renamed:</h2>

      <ul class="m-0 pl-5">
        <% @device.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form_with model: @device do |form| %>
    <div class="mb-6">
      <%= form.label :name, class: label_classes %>
      <%= form.text_field :name, required: true, autofocus: true, class: field_classes %>
      <p class="mb-0 mt-2 text-sm text-neutral-600">Type: <%= @device.device_type.humanize %></p>
    </div>

    <div class="flex flex-wrap gap-3">
      <%= form.submit "Save name", class: "#{button_classes} cursor-pointer" %>
      <%= link_to "Cancel", devices_path, class: button_classes(:secondary) %>
    </div>
  <% end %>
</div>
