<section class="mx-auto box-border w-full max-w-md rounded-2xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8">

<h1>Create a PhoneVault Account</h1>

<%= render "shared/errors", record: @user, prevented: "this account from being created" %>

<%= form_with model: @user, url: signup_path do |form| %>
  <div class="mb-5">
    <%= form.label :username, class: label_classes %>
    <%= form.text_field :username, required: true, autofocus: true, autocomplete: "username",
          autocapitalize: "none", autocorrect: "off", spellcheck: false, class: field_classes %>
  </div>

  <div class="mb-5">
    <%= form.label :display_name, class: label_classes %>
    <%= form.text_field :display_name, required: true, class: field_classes %>
  </div>

  <div class="mb-5">
    <%= form.label :password, class: label_classes %>
    <%= form.password_field :password, required: true, autocomplete: "new-password", class: field_classes %>
  </div>

  <div class="mb-5">
    <%= form.label :password_confirmation, class: label_classes %>
    <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", class: field_classes %>
  </div>

  <div class="mb-5">
    <%= form.submit "Create account", class: "#{button_classes(:brand)} w-full" %>
  </div>
<% end %>

<hr>

<p>Already have a PhoneVault account?</p>

<%= link_to "Sign in", login_path, class: "#{button_classes(:secondary)} w-full" %>

</section>
