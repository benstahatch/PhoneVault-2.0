<% if flash[:notice] %>
  <p><%= flash[:notice] %></p>
<% end %>

<% if flash[:alert] %>
  <p><%= flash[:alert] %></p>
<% end %>

<h1>Sign in to PhoneVault</h1>

<%= form_with url: login_path, scope: :session do |form| %>
  <div>
    <%= form.label :username %>
    <%= form.text_field :username,
          required: true,
          autofocus: true,
          autocomplete: "username" %>
  </div>

  <div>
    <%= form.label :password %>
    <%= form.password_field :password,
          required: true,
          autocomplete: "current-password" %>
  </div>

  <div>
    <%= form.submit "Sign in" %>
  </div>
<% end %>

<hr>

<p>New to PhoneVault?</p>

<%= button_to "Create your account", signup_path, method: :get %>
