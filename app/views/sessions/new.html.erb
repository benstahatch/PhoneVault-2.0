<section class="mx-auto box-border w-full max-w-md rounded-2xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8">

<h1>Sign in to PhoneVault</h1>

<%= form_with url: login_path, scope: :session do |form| %>
  <div class="mb-5">
    <%= form.label :username, class: label_classes %>
    <%= form.text_field :username, required: true, autofocus: true, autocomplete: "username",
          autocapitalize: "none", autocorrect: "off", spellcheck: false,
          placeholder: "Enter your username", class: field_classes %>
  </div>

  <div class="mb-5">
    <%= form.label :password, class: label_classes %>
    <%= form.password_field :password, required: true, autocomplete: "current-password", class: field_classes %>
  </div>

  <div class="mb-5">
    <%= form.submit "Sign in", class: "#{button_classes(:brand)} w-full" %>
  </div>
<% end %>

<hr>

<p>New to PhoneVault?</p>

<%= link_to "Create your account", signup_path, class: "#{button_classes(:secondary)} w-full" %>

</section>
