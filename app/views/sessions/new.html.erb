<h1>Log in to PhoneVault</h1>

<%= form_with url: login_path, scope: :session do |form| %>
  <div>
    <%= form.label :username %>
    <%= form.text_field :username,
          required: true,
          autofocus: true,
          autocomplete: "username" %>
  </div>

  <div>
    <%= form.label :password %>
    <%= form.password_field :password,
          required: true,
          autocomplete: "current-password" %>
  </div>

  <div>
    <%= form.submit "Log in" %>
  </div>
<% end %>
