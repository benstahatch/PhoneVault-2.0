<h1 class="mb-6 text-3xl sm:text-4xl font-bold text-neutral-900"><%= @device.name %> <span class="font-normal text-neutral-600">— Backups</span></h1>

<div class="mb-6 flex flex-wrap gap-3">
  <%= link_to "Upload a file", new_device_backup_run_path(@device), class: button_classes %>
  <%= link_to "Trash", trash_path, class: button_classes(:secondary) %>
  <%= link_to "Back to your devices", devices_path, class: button_classes(:secondary) %>
</div>

<% if @backup_runs.any? %>
  <div data-controller="image-preview">
  <div class="backup-history-scroll" role="region" aria-label="Backup history" tabindex="0">
    <table class="backup-history">
      <caption>Backup history, newest first. Times shown in <%= Time.zone.name %>.</caption>
      <thead>
        <tr>
          <th scope="col">Backup dates</th>
          <th scope="col">Status</th>
          <th scope="col">File</th>
          <th scope="col">Size</th>
          <th scope="col">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% @backup_runs.each do |run| %>
          <% files = run.active_backup_files.to_a %>
          <tr>
            <td rowspan="<%= [files.size, 1].max %>">
              <div>Created: <%= timestamp(run.created_at) %></div>
              <% if run.started_at %>
                <div>Started: <%= timestamp(run.started_at) %></div>
              <% end %>
              <% if run.completed_at %>
                <div>Finished: <%= timestamp(run.completed_at) %></div>
              <% end %>
            </td>
            <td rowspan="<%= [files.size, 1].max %>">
              <span class="backup-status backup-status--<%= run.status %>"><%= run.status.humanize %></span>
            </td>
            <% if files.empty? %>
              <td colspan="3"><%= run.failed? ? "Backup failed. No files were stored." : "No files stored yet." %></td>
            <% else %>
              <%= render "file_cells", file: files.first, run: run %>
            <% end %>
          </tr>
          <% files.drop(1).each do |file| %>
            <tr><%= render "file_cells", file: file, run: run %></tr>
          <% end %>
        <% end %>
      </tbody>
    </table>
  </div>
  <dialog data-image-preview-target="dialog"
    aria-labelledby="image-preview-title"
    aria-modal="true"
    class="m-auto max-h-[90vh] w-[min(96vw,72rem)] max-w-none rounded-xl border border-neutral-200 bg-white p-4 shadow-2xl backdrop:bg-black/70 sm:p-6"
    data-action="click->image-preview#backdrop">
    <div class="mb-3 flex items-start justify-between gap-4">
      <h2 id="image-preview-title" class="text-lg font-semibold text-neutral-900"
        data-image-preview-target="title"></h2>
      <button type="button" class="<%= button_classes(:secondary, size: :small) %>"
        aria-label="Close image preview" data-image-preview-target="closeButton"
        data-action="image-preview#close">Close</button>
    </div>
    <img data-image-preview-target="image" alt=""
      class="mx-auto max-h-[75vh] max-w-full rounded-md object-contain" />
  </dialog>
  </div>
<% else %>
  <p class="rounded-xl border border-neutral-200 bg-white p-5 text-neutral-600">No backups yet. Upload a file to create your first backup.</p>
<% end %>
