<% if flash[:notice] %>
  <p role="status"><%= flash[:notice] %></p>
<% end %>
<% if flash[:alert] %>
  <p role="alert"><%= flash[:alert] %></p>
<% end %>

<h1 class="mb-6 text-3xl sm:text-4xl font-bold text-neutral-900"><%= @device.name %> <span class="font-normal text-neutral-600">— Backups</span></h1>

<div class="mb-6 flex flex-wrap gap-3">
  <%= link_to "Upload a file", new_device_backup_run_path(@device), class: button_classes %>
  <%= link_to "Back to your devices", devices_path, class: button_classes(:secondary) %>
</div>

<% if @backup_runs.any? %>
  <div class="backup-history-scroll" role="region" aria-label="Backup history" tabindex="0">
    <table class="backup-history">
      <caption>Backup history, newest first. Times shown in <%= Time.zone.name %>.</caption>
      <thead>
        <tr>
          <th scope="col">Backup dates</th>
          <th scope="col">Status</th>
          <th scope="col">File</th>
          <th scope="col">Size</th>
          <th scope="col">Restore</th>
        </tr>
      </thead>
      <tbody>
        <% @backup_runs.each do |run| %>
          <% files = run.backup_files.to_a %>
          <tr>
            <td rowspan="<%= [files.size, 1].max %>">
              <div>Created: <%= tag.time(run.created_at.strftime("%b %d, %Y %H:%M %Z"), datetime: run.created_at.iso8601) %></div>
              <% if run.started_at %>
                <div>Started: <%= tag.time(run.started_at.strftime("%b %d, %Y %H:%M %Z"), datetime: run.started_at.iso8601) %></div>
              <% end %>
              <% if run.completed_at %>
                <div>Finished: <%= tag.time(run.completed_at.strftime("%b %d, %Y %H:%M %Z"), datetime: run.completed_at.iso8601) %></div>
              <% end %>
            </td>
            <td rowspan="<%= [files.size, 1].max %>">
              <span class="backup-status backup-status--<%= run.status %>"><%= run.status.humanize %></span>
            </td>
            <% if files.empty? %>
              <td colspan="3"><%= run.failed? ? "Backup failed. No files were stored." : "No files stored yet." %></td>
            <% else %>
              <%= render "file_cells", file: files.first, run: run %>
            <% end %>
          </tr>
          <% files.drop(1).each do |file| %>
            <tr><%= render "file_cells", file: file, run: run %></tr>
          <% end %>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <p class="rounded-xl border border-neutral-200 bg-white p-5 text-neutral-600">No backups yet. Upload a file to create your first backup.</p>
<% end %>
