<% if flash[:notice] %><p><%= flash[:notice] %></p><% end %>
<% if flash[:alert] %><p><%= flash[:alert] %></p><% end %>

<h1><%= @device.name %> — Backups</h1>

<% if @backup_runs.any? %>
  <ul>
    <% @backup_runs.each do |run| %>
      <li>
        <%= run.status %> —
        <% run.backup_files.each do |file| %><%= file.original_filename %><% end %>
      </li>
    <% end %>
  </ul>
<% else %>
  <p>No backups yet.</p>
<% end %>

<%= link_to "Upload a file", new_device_backup_run_path(@device) %>
