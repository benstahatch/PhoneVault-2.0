<% image_type = @preview.image_type(file) %>
<% excerpt = image_type ? nil : @preview.text_excerpt(file) %>
<td class="backup-file-details">
  <div class="flex items-start gap-3">
    <% if image_type %>
      <button type="button"
        class="group relative inline-flex rounded-md focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-orange-600"
        aria-label="Preview <%= file.original_filename %>"
        data-action="image-preview#open"
        data-image-preview-url-param="<%= preview_device_backup_run_backup_file_path(@device, run, file) %>"
        data-image-preview-alt-param="Preview of <%= file.original_filename %>">
        <%= image_tag preview_device_backup_run_backup_file_path(@device, run, file),
              alt: "", loading: "lazy",
              class: "h-16 w-16 rounded-md border border-neutral-200 bg-white object-cover" %>
        <span aria-hidden="true" class="absolute inset-0 flex items-center justify-center rounded-md bg-black/0 text-white opacity-0 transition group-hover:bg-black/35 group-hover:opacity-100 group-focus-visible:opacity-100">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
            stroke-width="2" class="h-6 w-6 drop-shadow">
            <path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12Z" />
            <circle cx="12" cy="12" r="3" />
          </svg>
        </span>
      </button>
    <% elsif excerpt.nil? %>
      <div class="h-16 w-16 shrink-0 rounded-md bg-[#171717] text-center text-xs font-bold leading-[4rem] text-white"
           aria-hidden="true"><%= @preview.badge(file) %></div>
    <% end %>
    <div class="min-w-0">
      <strong><%= file.original_filename %></strong>
      <% if excerpt %>
        <pre class="m-0 mt-2 max-w-sm overflow-hidden whitespace-pre-wrap break-words rounded-md border border-neutral-200 bg-neutral-50 p-2 font-mono text-xs leading-5 text-neutral-700"
             aria-label="First lines of <%= file.original_filename %>"><%= excerpt.text %><% if excerpt.truncated %>
…<% end %></pre>
      <% end %>
    </div>
  </div>
  <% if run.storage_root.present? || run.backup_subdirectory.present? %>
    <p class="text-sm break-all">Save folder: <code><%= run.storage_root.presence || BackupStorage.default_root.join(run.backup_subdirectory) %></code></p>
  <% end %>
  <details>
    <summary>SHA-256 details</summary>
    <p>Recorded when uploaded; file size and hash are checked again when restored.</p>
    <code><%= file.sha256 %></code>
  </details>
</td>
<td><%= number_to_human_size(file.size_bytes) %></td>
<td>
  <div class="flex flex-wrap gap-2">
    <%= link_to "Restore", restore_device_backup_run_backup_file_path(@device, run, file),
      class: button_classes(:secondary, size: :small), data: { turbo: false },
      aria: { label: "Restore #{file.original_filename}" } %>
    <%= button_to "Delete",
      device_backup_run_backup_file_path(@device, run, file),
      method: :delete,
      form: { data: { turbo_confirm: "Move #{file.original_filename} to Trash?" } },
      class: button_classes(:secondary, size: :small),
      aria: { label: "Delete #{file.original_filename}" } %>
  </div>
</td>
