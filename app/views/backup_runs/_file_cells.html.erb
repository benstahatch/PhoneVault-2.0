<td class="backup-file-details">
  <strong><%= file.original_filename %></strong>
  <% if run.storage_root.present? || run.backup_subdirectory.present? %>
    <p class="text-sm break-all">Save folder: <code><%= run.storage_root.presence || BackupStorage.default_root.join(run.backup_subdirectory) %></code></p>
  <% end %>
  <details>
    <summary>SHA-256 details</summary>
    <p>Recorded when uploaded; file size and hash are checked again when restored.</p>
    <code><%= file.sha256 %></code>
  </details>
</td>
<td><%= number_to_human_size(file.size_bytes) %></td>
<td>
  <%= link_to "Restore", restore_device_backup_run_backup_file_path(@device, run, file),
    class: button_classes(:secondary, size: :small), data: { turbo: false },
    aria: { label: "Restore #{file.original_filename}" } %>
</td>
